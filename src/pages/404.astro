---
import "../styles/global.css";
import FloatingNav from "../components/FloatingNav";
import Clarity from "../components/Clarity.astro";
import SecondaryPageInfo from "../components/SecondaryPageInfo.astro";
import Analytics from "@vercel/analytics/astro";

const url = "https://farmaciadeturnomc.site";
const title = "Página no encontrada (404) | Farmacias de Turno Monte Caseros";
const description =
  "La página que buscás no existe en Farmacias de Turno Monte Caseros. Encontrá la farmacia de turno de hoy, el calendario de próximos turnos o el directorio completo.";

const quickLinks = [
  {
    href: "/",
    name: "Farmacia de turno hoy",
    note: "El turno vigente con mapa y teléfono",
  },
  {
    href: "/calendario",
    name: "Calendario de turnos",
    note: "Fechas de los próximos turnos",
  },
  {
    href: "/farmacias",
    name: "Directorio de farmacias",
    note: "Todas las farmacias con teléfono y dirección",
  },
  { href: "/about", name: "Acerca del proyecto", note: "Qué es este sitio" },
  {
    href: "/contact",
    name: "Contacto",
    note: "Reportar datos desactualizados",
  },
  {
    href: "/privacy",
    name: "Política de privacidad",
    note: "Qué datos se recopilan",
  },
];
---

<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, follow" />
    <meta name="language" content="es-AR" />
    <link rel="canonical" href={`${url}/404`} />
    <link rel="describedby" href="/llms.txt" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="Farmacias de Turno Monte Caseros" />

    <meta name="theme-color" content="#166534" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lora:wght@500;600&family=Outfit:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <style>
      :root {
        --green-950: #052e16;
        --green-900: #14532d;
        --green-800: #166534;
        --green-700: #15803d;
        --green-600: #16a34a;
        --green-100: #dcfce7;
        --green-50: #f0fdf4;
        --zinc-900: #18181b;
        --zinc-700: #3f3f46;
        --zinc-500: #71717a;
        --zinc-200: #e4e4e7;
        --zinc-100: #f4f4f5;
        --zinc-50: #fafafa;
      }
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { font-family: 'Outfit', system-ui, sans-serif; -webkit-text-size-adjust: 100%; }
      body { background: var(--zinc-50); color: var(--zinc-900); min-height: 100vh; }

      .page-bg {
        position: fixed; inset: 0; z-index: 0; pointer-events: none;
        background: var(--zinc-50);
        background-image: radial-gradient(circle, #d4d4d8 1px, transparent 1px);
        background-size: 20px 20px;
      }

      main { position: relative; z-index: 1; max-width: 44rem; margin: 0 auto;
             padding: 1.5rem 1rem 10rem; }
      @media (min-width: 640px) { main { padding-top: 2.5rem; padding-inline: 1.5rem; } }

      .page-header { margin-bottom: 2rem; }
      .code-badge {
        display: inline-flex; align-items: center; gap: 0.375rem;
        background: var(--green-50); border: 1px solid var(--green-100);
        color: var(--green-800); font-size: 0.75rem; font-weight: 500;
        padding: 0.25rem 0.625rem; border-radius: 999px; margin-bottom: 0.875rem;
        letter-spacing: 0.01em;
      }
      h1 {
        font-family: 'Lora', Georgia, serif; font-size: 1.625rem; font-weight: 600;
        line-height: 1.25; color: var(--zinc-900); margin-bottom: 0.5rem;
        letter-spacing: -0.01em;
      }
      @media (min-width: 640px) { h1 { font-size: 2rem; } }
      .subtitle { font-size: 0.9375rem; color: var(--zinc-500); line-height: 1.65; }
      .subtitle a { color: var(--green-700); font-weight: 500; text-underline-offset: 3px; }
      .subtitle a:hover { text-decoration: underline; }

      .section-label {
        font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.08em;
        text-transform: uppercase; color: var(--zinc-500);
        margin-bottom: 0.875rem; margin-top: 1.75rem;
      }
      .section-label:first-of-type { margin-top: 0; }

      .link-list { display: flex; flex-direction: column; gap: 0.625rem; }
      .link-card {
        background: #fff; border: 1px solid var(--zinc-200);
        border-radius: 1rem; padding: 0.875rem 1rem;
        text-decoration: none; display: flex; flex-direction: column; gap: 0.125rem;
        transition: border-color 0.15s, box-shadow 0.15s;
      }
      .link-card:hover { border-color: #86efac; box-shadow: 0 2px 12px rgba(22,163,74,0.08); }
      .link-name {
        font-family: 'Lora', Georgia, serif; font-size: 1rem; font-weight: 600;
        color: var(--green-800); line-height: 1.3;
      }
      .link-note { font-size: 0.8125rem; color: var(--zinc-500); line-height: 1.5; }

      .agent-hint {
        margin-top: 2rem; border-top: 1px solid var(--zinc-200); padding-top: 1.25rem;
        font-size: 0.8125rem; color: var(--zinc-500); line-height: 1.6;
      }
      .agent-hint code {
        background: var(--zinc-100); border-radius: 0.375rem; padding: 0.125rem 0.375rem;
        font-size: 0.75rem;
      }
      .agent-hint a { color: var(--green-700); font-weight: 500; }
    </style>

    <Analytics />
    <Clarity />
  </head>

  <body>
    <div class="page-bg" aria-hidden="true"></div>

    <FloatingNav client:idle activePath="/404" />

    <main>
      <!-- ── Header ── -->
      <header class="page-header">
        <div class="code-badge">Error 404</div>
        <h1>Página no encontrada</h1>
        <p class="subtitle">
          La ruta que pediste no existe en este sitio, pero acá siempre podés
          encontrar qué farmacia está de turno en Monte Caseros.
          Volvé al <a href="/">inicio</a> o elegí una sección:
        </p>
      </header>

      <!-- ── Recovery links ── -->
      <nav aria-label="Enlaces sugeridos">
        <p class="section-label">Dónde continuar</p>
        <div class="link-list">
          {
            quickLinks.map((link) => (
              <a class="link-card" href={link.href}>
                <span class="link-name">{link.name}</span>
                <span class="link-note">{link.note}</span>
              </a>
            ))
          }
        </div>
      </nav>

      <SecondaryPageInfo />

      <!-- ── Agent resources ── -->
      <p class="agent-hint">
        Recursos para agentes y crawlers: guía del sitio en
        <code>/llms.txt</code> (<a href="/llms.txt">ver llms.txt</a>) e índice de
        páginas en <a href="/sitemap-index.xml">sitemap-index.xml</a>.
      </p>
    </main>
  </body>
</html>
